{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_WS_URL": "wss://market-research-agent-backend-00ao.onrender.com/ws/market",
    "NEXT_PUBLIC_API_BASE": "https://market-research-agent-backend-00ao.onrender.com",
    "NEXT_PUBLIC_BACKEND_URL": "https://market-research-agent-backend-00ao.onrender.com"
  }
}
