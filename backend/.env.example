# Copy this file to .env and fill in your values
# Never commit .env to git!

# ---------------------------------------------------------------------------
# LLM Providers — free/open-source first, so you never hit token limits.
# ---------------------------------------------------------------------------

# Priority order of providers to try (comma-separated).
#   ollama      — local, completely free, no token limits (install from ollama.com)
#   huggingface — Hugging Face Inference API, free tier for public models
#   openrouter  — cloud API (needs OPENROUTER_API_KEY)
# Default tries local → Hugging Face → OpenRouter.
LLM_PROVIDER_PRIORITY=ollama,huggingface,openrouter

# --- Ollama (local) ---------------------------------------------------------
# Defaults point at the standard local install. Run `ollama pull llama3.2` once.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Hugging Face Inference API (cloud, free tier) -------------------------
# Token is optional on the free tier but raises rate limits.
# Get one at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- OpenRouter (cloud, fallback) -------------------------------------------
# Get your free API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional second key for rate-limit rotation (effectively doubles free quota)
OPENROUTER_API_KEY_2=

# OpenRouter base URL (default is fine)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use — free tier
MODEL=google/gemini-2.5-flash:free

# ---------------------------------------------------------------------------
# Voice
# ---------------------------------------------------------------------------

# Optional — voice falls back to free Hugging Face + offline Python TTS if unset.
ELEVENLABS_API_KEY=

# Hugging Face TTS model (free, no API key required for public models)
HF_TTS_MODEL=facebook/mms-tts-eng

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# CORS allowed origins (comma-separated)
# In production: set this to your Vercel URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001